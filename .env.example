# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Gateway — Environment Variable Reference
# Copy to .env for local development. NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ─── Hello Service (Phase 1) ──────────────────────────────────────────────────
HELLO_SERVICE_URL=http://localhost:8081
HELLO_SERVICE_PORT=8081

# ─── PostgreSQL ── (Phase 6+) ─────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/sentinelgateway
DATABASE_USERNAME=sentinelgateway
DATABASE_PASSWORD=CHANGE_ME

# ─── Redis ── (Phase 8+) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ─── Kafka ── (Phase 13+) ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Keycloak ── (Phase 3+) ───────────────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/sentinel
KEYCLOAK_CLIENT_ID=sentinel-gateway
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ─── JWT ── (Phase 4+) ────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_MIN_256_BIT_KEY_IN_PRODUCTION

# ─── Observability ── (Phase 14+) ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
