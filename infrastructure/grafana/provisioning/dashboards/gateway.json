      "pluginVersion": "11.2.0",
      "title": "Total Requests",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "sum(gateway_requests_total)", "legendFormat": "Total", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}},
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "text": {}, "textMode": "auto", "colorMode": "background"},
      "pluginVersion": "11.2.0",
      "title": "Error Rate",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "sum(gateway_requests_total{outcome=~'UNAUTHENTICATED|UNAUTHORIZED|BLOCKED.*'}) / sum(gateway_requests_total)", "legendFormat": "Error Rate", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "title": "Request Rate by Route (req/s)",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "sum(rate(gateway_requests_total[1m])) by (route)", "legendFormat": "{{route}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
