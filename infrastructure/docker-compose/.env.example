# ─── Sentinel Gateway — Docker Compose Environment ────────────────────────────
# Copy this file to .env and adjust values before running `docker compose up`.

# Ports (change to avoid conflicts)
GATEWAY_PORT=8080
HELLO_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
KEYCLOAK_PORT=8180
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DASHBOARD_PORT=3001

# Database
DATABASE_PASSWORD=sentinel_secret

# Redis
REDIS_PASSWORD=redis_secret

# Keycloak admin credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# HMAC signing — change in production
HMAC_SHARED_SECRET=change-me-in-production
